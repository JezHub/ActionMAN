# GEMINI_API_KEY: Required for Gemini AI calls (brain dump parsing, coach,
# email triage, briefing commentary). Set via Replit Secrets in production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string. On Replit, attach a PostgreSQL
# database (Tools -> Database) and this is provided automatically. When unset,
# the server falls back to a local JSON file at .data/actionman-store.json
# (fine for development, NOT for production).
# DATABASE_URL="postgresql://user:pass@host/db"

# ALLOWED_EMAILS: comma-separated Google account emails allowed to use the
# app. Enforced server-side on every data route. Defaults to the built-in
# owner allowlist when unset.
# ALLOWED_EMAILS="jez@smileathon.com,jazz@smallathon.com"

# APP_URL: public URL of the deployed app; used as the briefing email's
# dashboard link fallback.
# APP_URL="https://your-app.replit.app"

# AGENT_API_TOKEN: shared secret for background agents (Claude Routines) to
# write briefs/reports into the app. Generate with: openssl rand -hex 32
# Must be at least 32 characters or it is ignored.
# AGENT_API_TOKEN="<openssl rand -hex 32>"

# AGENT_ACTS_AS_EMAIL: which user the agent token writes as.
# Defaults to the first allowlisted email.
# AGENT_ACTS_AS_EMAIL="jez@smileathon.com"

# DEV_AUTH_BYPASS_EMAIL: DEVELOPMENT ONLY. Skips Google token verification and
# acts as this user. Ignored when NODE_ENV=production. Never set in Replit
# Secrets for a deployment.
# DEV_AUTH_BYPASS_EMAIL="jez@smileathon.com"
